{
  "name": "medicore",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "npm run dev -w @medicore/web",
    "dev:api": "npm run dev -w @medicore/api",
    "build": "npm run build -w @medicore/web",
    "build:api": "npm run build -w @medicore/api",
    "preview": "npm run preview -w @medicore/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @medicore/web --",
    "test:contrato": "npm run test:contrato -w @medicore/api",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:verificar": "npm run i18n:verificar -w @medicore/web",
    "pacote:medir": "npm run pacote:medir -w @medicore/web --",
    "db:gerar": "npm run db:gerar -w @medicore/api",
    "db:migrar": "npm run db:migrar -w @medicore/api",
    "db:semear": "npm run db:semear -w @medicore/api"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
