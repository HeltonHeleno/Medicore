# Copie para apps/api/.env (lido por `npm run dev`, `db:migrar` e `db:semear`).
# Valores do docker-compose.yml da raiz.
AMBIENTE=desenvolvimento
PORTA=3000
DATABASE_URL=postgres://medicore_api:medicore_api@localhost:5432/medicore
DATABASE_URL_MIGRACAO=postgres://medicore:medicore@localhost:5432/medicore
LOG_NIVEL=info
# SENTRY_DSN=
# Rotinas do dia (retenção, lote vencido, invariantes). "nao" desliga nesta instância.
# ROTINAS=sim
# Fase 27: o app do `npm run dev` (Vite, porta 5173) chama a API pelo navegador.
CORS_ORIGENS=http://localhost:5173
# Fase 28: endereço do app nos links de convite e de senha nova.
APP_URL=http://localhost:5173
# E-mails (opcional). Sem provedor, o link aparece para o administrador copiar.
# EMAIL_PROVEDOR=resend
# RESEND_API_KEY=
# EMAIL_REMETENTE=MediCore <nao-responda@seu-dominio>
# Contas de demonstração na tela de login (padrão: ligadas fora da produção).
# LOGIN_DEMONSTRACAO=sim
