# Copie para .env.local e ajuste conforme necessário.

# "true" faz todas as chamadas do serviço simulado falharem (testa o estado de erro dos cards).
VITE_SIMULAR_ERRO=false

# Fase 23 — Monitoramento de erros (Sentry). Vazio = nenhum erro sai do navegador.
# A chave pública (DSN) do projeto medicore-web; na Vercel, só em Production e Preview.
VITE_SENTRY_DSN=

# Só no build da Vercel (nunca no .env.local): envio dos mapas de código ao Sentry.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=medicore-web
